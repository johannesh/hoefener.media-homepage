---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Schema from "@/components/seo/Schema.astro";
import Hero from "@/components/widgets/Hero.astro";
import Features from "@/components/widgets/Features.astro";
import ServiceList from "@/components/widgets/ServiceList.astro";
import Portfolio from "@/components/widgets/Portfolio.astro";
import Content2 from "@/components/widgets/Content2.astro";
import Steps from "@/components/widgets/Steps.astro";
import CallToAction from "@/components/widgets/CallToAction.astro";
import { siteConfig } from "@/config/site";
import devImg from "@/assets/images/dev_balanced.png";

// Lighthouse (mobile) scores of this site — re-check after larger changes
const lighthouseScores = [
  { label: "Performance", value: 100 },
  { label: "Barrierefreiheit", value: 100 },
  { label: "Best Practices", value: 100 },
  { label: "SEO", value: 100 },
];

const metadata = {
  title:
    "hoefener.media e.K. — Webdesign & Web-Engineering. Schön. Schnell. Sicher.",
  description:
    "Webdesign & Software-Engineering aus dem Fichtelgebirge. Über 10 Jahre Erfahrung, DevOps-Expertise und ein Auge für schönes Design.",
  ignoreTitleTemplate: true,
};
---

<BaseLayout {metadata}>
  <Schema type="ProfessionalService" slot="head" />

  <!-- Hero -->
  <Hero
    title={`<span class="sr-only">Webdesign und Web-Engineering: Schön. Schnell. Sicher.</span><span aria-hidden="true"><span class="whitespace-nowrap">Web-<span id="typewriter-text">Design</span><span class="typewriter-cursor">|</span></span><br/><span class="bg-linear-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">Schön. Schnell. Sicher.</span></span>`}
    tagline="Gespannt auf Ihre Projekte"
    description="Ich verbinde über 10 Jahre Webdesign-Erfahrung mit meiner Expertise als Head of DevOps. Das Ergebnis: schnelle Webpräsenzen, die Ihre Kunden begeistern."
    actions={[
      {
        text: "Leistungen entdecken",
        href: "/#leistungen",
        variant: "primary",
        icon: "lucide:arrow-down",
      },
      {
        text: "Kontakt aufnehmen",
        href: "/contact",
        variant: "secondary",
        icon: "lucide:mail",
        ariaLabel: "Jetzt Kontakt aufnehmen",
      },
    ]}
  />

  <!-- Leistungen -->
  <ServiceList
    id="leistungen"
    tagline="Leistungen"
    title="Was ich für Sie umsetze"
    subtitle="Von der ersten Idee bis zum laufenden Betrieb — alles aus einer Hand."
    services={[
      {
        title: "Webdesign & Entwicklung",
        description:
          "Individuelle Websites, die Ihre Marke widerspiegeln. Ich designe und entwickle moderne, schnelle und barrierefreie Webpräsenzen — maßgeschneidert für Ihr Unternehmen.",
        icon: "lucide:layout-template",
      },
      {
        title: "WordPress & CMS",
        description:
          "Professionelle WordPress-Websites, die Sie selbst verwalten können. Ich richte alles ein, erkläre alles verständlich und bin bei Fragen weiterhin für Sie da.",
        icon: "lucide:pen-tool",
      },
      {
        title: "Hosting & Betrieb",
        description:
          "Von RaspberryPi bis Hyperscaler: Sicheres Hosting, automatische Backups, Monitoring und automatisierte Updates. Ich überwache den Betrieb Ihrer Website professionell — mit Audit-fähigen Werkzeugen aus dem Enterprise-Umfeld.",
        icon: "lucide:server",
      },
    ]}
  />

  <!-- Warum ich -->
  <Features
    id="warum"
    tagline="Warum hoefener.media"
    title="Design trifft Ingenieurskunst"
    subtitle="Ich denke Webdesign ganzheitlich — von der ersten Skizze und kreativem Design bis zum sicheren, zuverlässigen Betrieb über viele Jahre."
    features={[
      {
        title: "Schön",
        description:
          "Ein Design, das zu Ihrer Marke passt und auf jedem Gerät überzeugt — von Smartphones über Screenreader bis zum Widescreen. Mobile First ist Standard, denn die meisten Ihrer Besucher kommen per Smartphone.",
        icon: "lucide:sparkles",
        iconClass: "bg-pink-500/10 text-pink-400",
      },
      {
        title: "Schnell",
        description:
          "Optimierte Bilder, schlanker Code und moderne Frameworks für kurze Ladezeiten. Das freut Ihre Besucher — und Google: Schnelle Seiten mit sauberem HTML und strukturierten Daten werden besser gefunden.",
        icon: "lucide:zap",
        iconClass: "bg-yellow-500/10 text-yellow-400",
      },
      {
        title: "Audit-Sicher",
        description:
          "SSL/TLS, sichere Deployments, automatische Backups, regelmäßige Updates und Schutz gegen die OWASP Top 10 — von Anfang an eingebaut und dauerhaft überwacht. Bei Bedarf alles integriert in Ihr ISMS nach ISO 27001.",
        icon: "lucide:shield-check",
        iconClass: "bg-green-500/10 text-green-400",
      },
    ]}
  >
    <div
      class="mt-10 flex flex-col items-center gap-6 rounded-2xl border border-border bg-card/50 p-6 md:flex-row md:justify-between md:p-8"
    >
      <div class="text-center md:text-left">
        <p class="font-semibold text-foreground">
          Der Beweis: diese Website im Google-Lighthouse-Test
        </p>
        <p class="text-sm text-muted-foreground">
          Mobil gemessen —
          <a
            href={`https://pagespeed.web.dev/analysis?url=${encodeURIComponent(siteConfig.url)}&form_factor=mobile`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary underline hover:no-underline">selbst prüfen ↗</a
          >
        </p>
      </div>
      <dl class="grid grid-cols-2 gap-3 sm:flex sm:gap-6">
        {
          lighthouseScores.map((score) => (
            <div class="flex flex-col-reverse items-center gap-2">
              <dt class="whitespace-nowrap text-xs text-muted-foreground">
                {score.label}
              </dt>
              <dd class="flex h-14 w-14 items-center justify-center rounded-full border-4 border-green-600 text-lg font-bold text-green-700 dark:border-green-500 dark:text-green-400">
                {score.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Features>

  <!-- Portfolio / Referenzen -->
  <Portfolio
    id="portfolio"
    tagline="Portfolio"
    title="Ausgewählte Referenzen"
    subtitle="Einige Projekte, die ich mit Leidenschaft umgesetzt habe. Weitere Details auf Anfrage."
    projects={[
      {
        title: "Regionalmanagement Taunus Website",
        description:
          "Moderne WordPress-Website für den Verein Regionalentwicklung Taunus e.V. Mit Elementor zur selbstständigen Pflege responsiver Inhalte.",
        icon: "lucide:hand-coins",
        link: "https://regionalmanagement-taunus.de/",
        tags: ["WordPress", "Elementor"],
      },
      {
        title: "Lernplattform Infrastruktur",
        description:
          "Betrieb der Serverinfrastruktur mit einem Docker Netzwerk für mehrere Dienste hinter Azure OAuth inkl. Infrastructure as Code (IaC) für automatisierte Backups, Monitoring, Security und Patch-Management - ISO 27001 konform.",
        icon: "lucide:graduation-cap",
        tags: ["Docker", "Azure", "IaC"],
      },
      {
        title: "Vereins-Website",
        description:
          "Pflegeleichte WordPress-Site für einen Verein — inkl. Veranstaltungskalender, Mitgliederbereich und Online-Shop.",
        icon: "lucide:users",
        link: "https://efb-ev.org/",
        tags: ["WordPress", "Online-Shop"],
      },
    ]}
  />

  <!-- Ablauf -->
  <Steps
    id="ablauf"
    tagline="Ablauf"
    title="So arbeiten wir zusammen"
    subtitle="Vier klare Schritte — von der ersten Idee bis zur laufenden Website."
    steps={[
      {
        title: "Kostenloses Erstgespräch",
        description:
          "In einem kurzen Telefonat oder Video-Call besprechen wir Ihr Vorhaben, und ich gebe Ihnen eine erste Einschätzung.",
        icon: "lucide:phone",
      },
      {
        title: "Angebot innerhalb von 48h",
        description:
          "Sie erhalten ein detailliertes Angebot mit klarem Leistungsumfang, Zeitplan und transparenter Preisgestaltung.",
        icon: "lucide:file-text",
      },
      {
        title: "Design & Umsetzung",
        description:
          "Ich entwerfe das Design, stimme es mit Ihnen ab und setze es um. Sie sehen den Fortschritt laufend und geben Feedback, bevor etwas live geht.",
        icon: "lucide:pen-tool",
      },
      {
        title: "Launch & Betreuung",
        description:
          "Ich bringe Ihre Website online und kümmere mich auf Wunsch um Hosting, Updates und Backups. Kein Callcenter, kein Ticketsystem — Sie haben immer einen direkten Ansprechpartner.",
        icon: "lucide:rocket",
      },
    ]}
  />

  <!-- Über mich -->
  <Content2
    id="ueber-mich"
    tagline="Über mich"
    title="Webdesign mit Tiefe"
    subtitle="Ich bin Johannes Höfener, Webdesigner und Software-Ingenieur aus dem Fichtelgebirge. Ich nehme bewusst nur ausgewählte Projekte an — so bekommt jedes meine volle Aufmerksamkeit und die Sorgfalt, die es verdient."
    items={[
      {
        title: "Beruflich verwurzelt in DevOps",
        description:
          "Im Hauptberuf verantworte ich als Head of DevOps skalierbare Systeme — dieses Wissen fließt direkt in jede Website ein, die ich entwickle.",
        icon: "lucide:code-2",
        iconClass: "bg-blue-500/10 text-blue-400",
      },
      {
        title: "Regional verbunden",
        description:
          "Ich bin im Fichtelgebirge/Franken verwurzelt und freue mich besonders auf Projekte aus der Region — persönlicher Kontakt ist mir wichtig.",
        icon: "lucide:map-pin",
        iconClass: "bg-green-500/10 text-green-400",
      },
      {
        title: "Transparent & verlässlich",
        description:
          "Klare Kommunikation, realistische Zeitpläne und Preise ohne versteckte Kosten. Sie wissen immer, woran wir gerade arbeiten.",
        icon: "lucide:handshake",
        iconClass: "bg-purple-500/10 text-purple-400",
      },
    ]}
    image={devImg}
    imageAlt="Web-Entwicklung mit Sorgfalt"
  />

  <!-- Kontakt CTA -->
  <CallToAction
    id="kontakt"
    tagline="Jetzt starten"
    title="Ihr Projekt verdient das Beste"
    subtitle="Sie haben eine Idee oder möchten Ihre bestehende Website verbessern? Das Erstgespräch ist kostenlos und unverbindlich."
    actions={[
      {
        text: "Projekt anfragen",
        href: "/contact",
        variant: "primary",
        icon: "lucide:send",
      },
    ]}
  />
</BaseLayout>

<script>
  const words = ["Engineering", "Design", "Entwicklung", "Apps", "Hosting"];
  const TYPING_SPEED = 80;
  const DELETING_SPEED = 50;
  const PAUSE_DURATION = 3000;

  let currentWordIndex = 1; // "Design" is shown first (matches initial HTML)
  let isDeleting = false;
  let charIndex = words[1].length;
  let wordsTyped = 0;
  let typewriterTimer: number | null = null;

  // Run through all words once, then settle on "Design" and stop (WCAG 2.2.2)
  function stopTypewriter(): void {
    document.querySelector(".typewriter-cursor")?.classList.add("hidden");
  }

  function type(): void {
    const textEl = document.getElementById("typewriter-text");
    if (!textEl) return;

    const currentWord = words[currentWordIndex];

    if (isDeleting) {
      charIndex--;
      textEl.textContent = currentWord.substring(0, charIndex);

      if (charIndex === 0) {
        isDeleting = false;
        currentWordIndex = (currentWordIndex + 1) % words.length;
        typewriterTimer = window.setTimeout(type, TYPING_SPEED);
      } else {
        typewriterTimer = window.setTimeout(type, DELETING_SPEED);
      }
    } else {
      const word = words[currentWordIndex];
      charIndex++;
      textEl.textContent = word.substring(0, charIndex);

      if (charIndex === word.length) {
        wordsTyped++;
        if (wordsTyped === words.length) {
          stopTypewriter();
          return;
        }
        typewriterTimer = window.setTimeout(() => {
          isDeleting = true;
          type();
        }, PAUSE_DURATION);
      } else {
        typewriterTimer = window.setTimeout(type, TYPING_SPEED);
      }
    }
  }

  function initTypewriter(): void {
    if (typewriterTimer !== null) {
      window.clearTimeout(typewriterTimer);
      typewriterTimer = null;
    }

    const textEl = document.getElementById("typewriter-text");
    if (!textEl) return;

    // Respect the user's motion preferences
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    currentWordIndex = 1;
    wordsTyped = 0;
    isDeleting = false;
    charIndex = words[currentWordIndex].length;
    textEl.textContent = words[currentWordIndex];

    typewriterTimer = window.setTimeout(() => {
      isDeleting = true;
      type();
    }, PAUSE_DURATION);
  }

  document.addEventListener("astro:page-load", initTypewriter);
</script>
