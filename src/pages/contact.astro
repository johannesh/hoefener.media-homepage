---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Features from "@/components/widgets/Features.astro";
import Content from "@/components/widgets/Content.astro";
import Form from "@/components/ui/Form.astro";

const metadata = {
  title: "Kontakt",
  description:
    "Nehmen Sie Kontakt mit uns auf und lassen Sie uns über Ihr nächstes Projekt sprechen.",
};

const visionText = [
  "Nehmen Sie Kontakt mit uns auf und lassen Sie uns über Ihr nächstes Projekt sprechen.",
];
---

<BaseLayout {metadata}>
  <Content tagline="Kontakt" title="Kontakt" description={visionText} />
  <div
    class="reveal mx-auto max-w-xl bg-card border border-border rounded-3xl p-8 shadow-sm mb-12 md:mb-16"
  >
    <Form />
  </div>
  <Features
    tagline="Kontaktmöglichkeiten"
    title="Wir sind für Sie da"
    subtitle="Wählen Sie den Kommunikationsweg, der Ihnen am liebsten ist. Wir antworten innerhalb von 24 Stunden."
    classes={{ container: "pt-0 md:pt-0" }}
    features={[
      {
        title: "Erstgespräch",
        description: "30 Min. unverbindlich. Hier zur Terminbuchung",
        icon: "lucide:phone",
        iconClass: "bg-green-500/10 text-green-400",
      },
      {
        title: "E-Mail",
        description: "johannes@hoefener.media",
        icon: "lucide:mail",
        iconClass: "bg-yellow-500/10 text-yellow-400",
      },
      {
        title: "Standort",
        description: "Nagel, Deutschland",
        icon: "lucide:map-pin",
        iconClass: "bg-red-500/10 text-red-400",
      },
      {
        title: "Persönliche Betreuung",
        description:
          "Wir verstehen Ihre Anforderungen und entwickeln passgenaue Lösungen.",
        icon: "lucide:user-check",
        iconClass: "bg-blue-500/10 text-blue-400",
      },
      {
        title: "Technischer Support",
        description:
          "Wir klären Fragen und beheben technische Probleme schnell.",
        icon: "lucide:wrench",
        iconClass: "bg-purple-500/10 text-purple-400",
      },
      {
        title: "Strategische Beratung",
        description: "Wir beraten Sie, damit Ihr Projekt ein Erfolg wird.",
        icon: "lucide:briefcase",
        iconClass: "bg-pink-500/10 text-pink-400",
      },
    ]}
  />
</BaseLayout>
