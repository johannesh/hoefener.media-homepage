---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/widgets/Hero.astro";

const metadata = {
  title: "404 – Seite nicht gefunden",
  description: "Die gesuchte Seite existiert nicht.",
  ignoreTitleTemplate: true,
};
---

<BaseLayout {metadata}>
  <Hero
    title={`<span class="sr-only">Fehler 404: Seite nicht gefunden</span><span aria-hidden="true" class="block bg-linear-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent text-[12rem] font-extrabold tracking-tighter mb-4">404</span>`}
    description="Die gesuchte Seite konnte leider nicht gefunden werden. Möglicherweise wurde sie verschoben oder gelöscht."
    actions={[
      {
        variant: "primary",
        text: "Zur Startseite",
        href: "/",
        icon: "lucide:home",
      },
      {
        variant: "secondary",
        text: "Kontakt",
        href: "/contact",
        icon: "lucide:phone",
      },
    ]}
  />
</BaseLayout>
