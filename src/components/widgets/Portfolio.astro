---
import WidgetWrapper from "./WidgetWrapper.astro";
import Headline from "@/components/ui/Headline.astro";
import type { PortfolioProps } from "@/types/types";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

const {
  title = await Astro.slots.render("title"),
  subtitle = await Astro.slots.render("subtitle"),
  tagline,
  projects = [],
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render("bg"),
  animate = true,
} = Astro.props as PortfolioProps;

const cardClass =
  "group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition-all";

const displayDomain = (url: string) =>
  new URL(url).hostname.replace(/^www\./, "");
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-7xl mx-auto ${classes?.container ?? ""}`}
  bg={bg}
  animate={animate}
>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: "max-w-3xl mx-auto text-center",
    }}
  />

  <ul class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
    {
      projects.map(
        ({
          title: projectTitle,
          description,
          image,
          imageAlt,
          icon,
          link,
          tags,
        }) => {
          const Tag = link ? "a" : "div";
          return (
            <li>
              <Tag
                class:list={[
                  cardClass,
                  link &&
                    "hover:border-primary/50 hover:shadow-md focus-visible:border-primary",
                ]}
                {...(link && {
                  href: link,
                  target: "_blank",
                  rel: "noopener noreferrer",
                })}
              >
                {image && (
                  <div class="aspect-video overflow-hidden border-b border-border bg-muted">
                    {typeof image === "string" ? (
                      <img
                        src={image}
                        alt={imageAlt ?? ""}
                        class:list={[
                          "h-full w-full object-cover object-top transition-transform duration-500",
                          link && "group-hover:scale-105",
                        ]}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <Image
                        src={image}
                        alt={imageAlt ?? ""}
                        widths={[400, 800, 1200]}
                        sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw"
                        class:list={[
                          "h-full w-full object-cover object-top transition-transform duration-500",
                          link && "group-hover:scale-105",
                        ]}
                      />
                    )}
                  </div>
                )}
                <div class="flex grow flex-col p-8">
                  {!image && icon && (
                    <div class="mb-4 text-primary">
                      <Icon name={icon} class="h-12 w-12" />
                    </div>
                  )}
                  <h3
                    class:list={[
                      "mb-2 text-xl font-bold text-foreground transition-colors",
                      link && "group-hover:text-primary",
                    ]}
                  >
                    {projectTitle}
                  </h3>
                  <p class="text-sm text-muted-foreground">{description}</p>
                  {tags && tags.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {tags.map((tag) => (
                        <span class="rounded-md bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                  {link && (
                    <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-semibold text-primary">
                      {displayDomain(link)}
                      <Icon
                        name="lucide:external-link"
                        class="h-4 w-4"
                        aria-hidden="true"
                      />
                      <span class="sr-only">(öffnet in neuem Tab)</span>
                    </span>
                  )}
                </div>
              </Tag>
            </li>
          );
        },
      )
    }
  </ul>
</WidgetWrapper>
