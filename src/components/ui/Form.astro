---
import Button from "./Button.astro";

interface Props {
  action?: string;
  method?: "GET" | "POST";
}

const { action = "/api/contact", method = "POST" } = Astro.props;
---

<form action={action} method={method} class="group space-y-6" data-contact-form>
  <p
    data-form-status
    role="status"
    aria-live="polite"
    class="hidden rounded-xl border px-4 py-3 text-sm font-medium"
  >
  </p>
  <!-- Honeypot field against spam bots, hidden from users -->
  <div class="hidden" aria-hidden="true">
    <label for="website">Website</label>
    <input
      type="text"
      name="website"
      id="website"
      tabindex="-1"
      autocomplete="off"
    />
  </div>
  <div>
    <label for="name" class="block text-sm font-medium text-foreground/80 mb-2"
      >Name</label
    >
    <input
      type="text"
      name="name"
      id="name"
      autocomplete="name"
      required
      maxlength="100"
      class="block w-full rounded-xl border-border bg-muted/50 px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 transition-all border outline-none focus:ring-4 group-data-success:border-green-500 group-data-success:bg-green-500/10"
      placeholder="Ihr Name"
    />
  </div>
  <div>
    <label for="email" class="block text-sm font-medium text-foreground/80 mb-2"
      >E-Mail</label
    >
    <input
      type="email"
      name="email"
      id="email"
      autocomplete="email"
      required
      maxlength="254"
      class="block w-full rounded-xl border-border bg-muted/50 px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 transition-all border outline-none focus:ring-4 group-data-success:border-green-500 group-data-success:bg-green-500/10"
      placeholder="ihre@email.de"
    />
  </div>
  <div>
    <label
      for="message"
      class="block text-sm font-medium text-foreground/80 mb-2">Nachricht</label
    >
    <textarea
      name="message"
      id="message"
      rows="4"
      required
      maxlength="5000"
      class="block w-full rounded-xl border-border bg-muted/50 px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/40 transition-all border outline-none focus:ring-4 resize-none group-data-success:border-green-500 group-data-success:bg-green-500/10"
      placeholder="Wie können wir Ihnen helfen?"></textarea>
  </div>
  <p class="text-sm text-muted-foreground">
    Ihre Angaben verwenden wir ausschließlich zur Bearbeitung Ihrer Anfrage.
    Weitere Informationen finden Sie in unserer
    <a href="/datenschutz" class="text-primary underline hover:no-underline"
      >Datenschutzerklärung</a
    >.
  </p>
  <div>
    <Button type="submit" size="lg" class="w-full sm:w-auto">
      Nachricht senden
    </Button>
  </div>
</form>

<script>
  const messages = {
    sending: "Nachricht wird gesendet …",
    sent: "Vielen Dank! Ihre Nachricht wurde gesendet. Wir melden uns schnellstmöglich bei Ihnen.",
    error:
      "Ihre Nachricht konnte leider nicht gesendet werden. Bitte versuchen Sie es später erneut oder schreiben Sie uns eine E-Mail.",
  };

  const successClasses = [
    "border-green-500/40",
    "bg-green-500/10",
    "text-green-600",
  ];
  const errorClasses = ["border-red-500/40", "bg-red-500/10", "text-red-600"];
  const SUCCESS_HIGHLIGHT_MS = 5000;

  const showStatus = (el: HTMLElement, state: keyof typeof messages) => {
    el.textContent = messages[state];
    el.classList.remove("hidden", ...successClasses, ...errorClasses);
    if (state === "sent") el.classList.add(...successClasses);
    if (state === "error") el.classList.add(...errorClasses);
    el.scrollIntoView({ behavior: "smooth", block: "nearest" });
  };

  const initContactForms = () => {
    document
      .querySelectorAll<HTMLFormElement>("form[data-contact-form]")
      .forEach((form) => {
        if (form.dataset.bound) return;
        form.dataset.bound = "true";
        const status = form.querySelector<HTMLElement>("[data-form-status]")!;
        const submit = form.querySelector<HTMLButtonElement>(
          'button[type="submit"]',
        )!;

        // Status from the no-JavaScript fallback redirect
        const fallback = new URLSearchParams(location.search).get("status");
        if (fallback === "sent" || fallback === "error")
          showStatus(status, fallback);

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          submit.disabled = true;
          showStatus(status, "sending");
          try {
            const response = await fetch(form.action, {
              method: "POST",
              body: new FormData(form),
              headers: { accept: "application/json" },
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok || !result.ok) throw new Error(result.error);
            form.reset();
            showStatus(status, "sent");
            // Briefly highlight the fields green to confirm the submission
            form.dataset.success = "";
            setTimeout(() => delete form.dataset.success, SUCCESS_HIGHLIGHT_MS);
          } catch {
            showStatus(status, "error");
          } finally {
            submit.disabled = false;
          }
        });
      });
  };

  initContactForms();
  document.addEventListener("astro:page-load", initContactForms);
</script>
